{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "separateMajorMinor": false,
  "separateMultipleMajor": false,
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 3am"
    ],
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "Keep OpenTelemetry on 0.32 until sqlx-otel supports 0.33",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "opentelemetry",
        "opentelemetry_sdk",
        "opentelemetry-otlp"
      ],
      "allowedVersions": "<0.33"
    },
    {
      "description": "Keep tracing-opentelemetry paired with OpenTelemetry 0.32",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "tracing-opentelemetry"
      ],
      "allowedVersions": "<0.34"
    },
    {
      "description": "Cargo lockfile maintenance is age-gated by repository CI",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "minimumReleaseAge": null,
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
