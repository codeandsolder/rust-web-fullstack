{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "separateMajorMinor": true,
  "separateMultipleMajor": false,
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 3 * * 1"
    ],
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "Keep OpenTelemetry on 0.32 until sqlx-otel supports 0.33",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "opentelemetry",
        "opentelemetry_sdk",
        "opentelemetry-otlp"
      ],
      "allowedVersions": "<0.33"
    },
    {
      "description": "Keep tracing-opentelemetry paired with OpenTelemetry 0.32",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "tracing-opentelemetry"
      ],
      "allowedVersions": "<0.34"
    },
    {
      "description": "One daily compatible update batch across Cargo, Docker and CI producers",
      "matchUpdateTypes": [
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "Daily compatible dependencies",
      "groupSlug": "daily-compatible-dependencies",
      "automerge": true,
      "matchDatasources": [
        "!rust-version"
      ],
      "matchPackageNames": [
        "!rust"
      ]
    },
    {
      "description": "Include stable minor updates in the same daily batch",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "groupName": "Daily compatible dependencies",
      "groupSlug": "daily-compatible-dependencies",
      "automerge": true,
      "matchDatasources": [
        "!rust-version"
      ],
      "matchPackageNames": [
        "!rust"
      ]
    },
    {
      "description": "Do not let potentially breaking upgrades occupy the daily batch; request them from the dashboard",
      "matchUpdateTypes": [
        "major",
        "replacement"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": "Breaking dependencies review",
      "groupSlug": "breaking-dependencies-review",
      "matchDatasources": [
        "!rust-version"
      ]
    },
    {
      "description": "Review 0.x minor upgrades on demand",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "/^0\\./",
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": "Breaking dependencies review",
      "groupSlug": "breaking-dependencies-review",
      "matchDatasources": [
        "!rust-version"
      ]
    }
  ],
  "timezone": "Etc/UTC",
  "schedule": [
    "* 3 * * 0,2-6"
  ],
  "automergeSchedule": [
    "* 0-2,4-23 * * *"
  ],
  "updateNotScheduled": false,
  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1
}
